{
  "name": "read-model-react",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch --preserveWatchOutput",
    "test": "node --import ./build/tmp/test/setup.ts --test 'src/main/tsc/**/*.test.ts' 'src/main/tsc/**/*.test.tsx'",
    "test:watch": "node --import ./build/tmp/test/setup.ts --test --watch 'src/main/tsc/**/*.test.ts' 'src/main/tsc/**/*.test.tsx'"
  },
  "vendor": {
    "react": "react",
    "react-dom": "react-dom",
    "client": "react-dom/client",
    "zustand": "zustand"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "scheduler": "^0.27.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
