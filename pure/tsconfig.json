{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "types": [],
    "verbatimModuleSyntax": true,
    "rootDir": "src/main/tsc",
    "outDir": "build/dist",
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noEmitOnError": true,
    "isolatedModules": true,
    "paths": {
      "/harness/read-model-harness.mjs": [
        "../harness/build/dist/js/productionLibrary/read-model-harness.d.mts"
      ]
    }
  },
  "include": [
    "src/main/tsc/**/*.ts",
    "node_modules/@types/jest/index.d.ts"
  ]
}
